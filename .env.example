# Copy to .env.local for local work. NEVER commit real values.
# Public (safe for the browser): the Supabase project URL and the anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used only by the outbox worker and internal routes.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret that protects the internal outbox/worker route (use a long random value).
INTERNAL_WORKER_SECRET=

# AI gateway (module: knowledge). Leave empty to keep the assistant disabled.
ANTHROPIC_API_KEY=
